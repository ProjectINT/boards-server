{
  "name": "boards-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:seeds": "PROTOCOL_SEEDS=200 vitest run test/protocol.test.ts",
    "test:load": "node scripts/load.mjs",
    "check:types": "tsc -p tsconfig.test.json",
    "sync:shared": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/check-shared.mjs"
  },
  "dependencies": {
    "@prometheus-io/client": "^0.16.1",
    "jose": "^6.1.0",
    "pino": "^9.13.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
